# 复制为 .env 后按需填写（不要提交真实密钥）

# 服务
PORT=5000
HOST=0.0.0.0
# NODE_ENV=production

# 数据目录（默认 ./data）
# DATA_DIR=./data

# JWT（生产必须设置；开发未设置时使用弱默认值并打印警告）
JWT_SECRET=please-change-me-to-a-long-random-string
# JWT_EXPIRES=7d
# WS_TICKET_EXPIRES=60s

# CORS 白名单，逗号分隔。生产若前后端不同域必须配置。
# 例：https://mykanban.example.com,http://localhost:5173
# CORS_ORIGINS=

# 登录/注册限流（按 IP）
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000

# 无版本旧库强制清空重建（会丢数据）
# ALLOW_LEGACY_DB_RESET=0

# 板内 AI（OpenAI 兼容接口；未设置 AI_API_KEY 时接口返回 503）
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# 仅 Node 出网代理，例如本机 Clash：http://192.168.3.82:1082
# AI_HTTP_PROXY=
# AI_TIMEOUT_MS=45000
# AI_RATE_LIMIT_MAX=30
# AI_RATE_LIMIT_WINDOW_MS=900000
