# 复制为 .env 后按需修改（不要提交真实密钥）

# 服务
PORT=5000
HOST=0.0.0.0
# NODE_ENV=production

# 数据库：仅支持 MySQL（已移除 SQLite）
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=kanban
MYSQL_PASSWORD=kanban
MYSQL_DATABASE=kanban
# MYSQL_POOL_SIZE=10

# Redis：默认必连（与 docker compose 一致）
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# 应急跳过 Redis（不推荐）：REDIS_OPTIONAL=1

# 看板整板读缓存 TTL（秒）
# BOARD_CACHE_TTL_SEC=30

# JWT（生产必须设置）
JWT_SECRET=please-change-me-to-a-long-random-string
# JWT_EXPIRES=7d
# WS_TICKET_EXPIRES=60s

# CORS 白名单，逗号分隔
# CORS_ORIGINS=http://localhost:5173

# 登录/注册限流
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000

# 板内 AI（可选）
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
