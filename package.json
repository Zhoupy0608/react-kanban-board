{
  "name": "myreacttrello",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:prod": "npm run build && node server.js --prod",
    "dev": "node server.js",
    "dev:vite": "vite",
    "server": "node server.js",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "migrate": "node scripts/migrate.mjs status",
    "lint": "eslint .",
    "preview": "vite preview",
    "share": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/share.ps1",
    "share:auth": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/share-auth.ps1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "undici": "^8.10.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "supertest": "^7.2.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
